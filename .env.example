# ============================================================
# BiblioGestor — Variáveis de ambiente (backend)
# Copie este arquivo para .env e preencha os valores reais.
# NÃO commite o .env (ele está no .gitignore).
# ============================================================

# --- Servidor ---
PORT=3000

# --- Banco de dados (SQLite) ---
DB_STORAGE=./src/database/database.sqlite

# --- SMTP / Nodemailer ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=workmailtest404@gmail.com
SMTP_PASS=
EMAIL_FROM=workmailtest404@gmail.com
# Em desenvolvimento, os avisos de devolução/atraso são enviados para este e-mail
EMAIL_TO_TEST=workmailtest404@gmail.com

# --- Agendamento das cobranças por e-mail ---
# Horário (0-23) em que o cron roda diariamente para enviar os avisos
CRON_HOUR=8
# Limiar (dias) para avisar "devolva em breve" antes do vencimento
CRON_DUE_SOON_DAYS=2

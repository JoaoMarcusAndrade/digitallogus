# ============================================================
# Alexandria — Variáveis de ambiente (backend)
# Copie este arquivo para .env e preencha os valores reais.
# NÃO commite o .env (ele está no .gitignore).
# ============================================================

# --- Servidor ---
PORT=3000

# --- Banco de dados (SQLite) ---
DB_STORAGE=./src/database/database.sqlite

# --- SMTP / Nodemailer ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=workmailtest404@gmail.com
# Senha de app do Gmail (sem espaços). Vazio = os e-mails são apenas logados.
SMTP_PASS=
EMAIL_FROM=workmailtest404@gmail.com
# Redireciona TODOS os avisos (senha provisória, vencimento, atraso) para este
# e-mail. Deixe vazio para cada aviso ir para o e-mail real do leitor.
EMAIL_REDIRECT_TO=

# --- Agendamento das notificações por e-mail ---
# Horário (0-23) em que o cron roda diariamente para enviar os avisos
CRON_HOUR=8
# Limiar (dias) para avisar "devolva em breve" antes do vencimento
CRON_DUE_SOON_DAYS=2

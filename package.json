
{
  "name": "livraria",
  "version": "1.0.0",
  "description": "sistema de livraria publica",
  "license": "MIT",
  "author": "Joao Andrade, Luiz NovoChatsky, David Kevin, Matheus Gabriel, Lucas Cobucci",
  "type": "module",
  "main": "server.js",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "concurrently -n backend,frontend -c blue,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build --workspaces",
    "start": "npm run start -w backend"
  },
  "dependencies": {
    "express": "^5.2.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.1": true,
    "sqlite3@6.0.1": true
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}